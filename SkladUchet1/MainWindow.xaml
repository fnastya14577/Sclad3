<Window x:Class="SkladUchet1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Склад: учёт сроков годности" Height="720" Width="1150"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,16">
            <TextBlock Text="Управление складом" FontSize="26" FontWeight="SemiBold" Foreground="#37474F"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" Padding="16" Margin="8,0,8,16" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Внимание! Истекают сроки годности" FontWeight="Bold" Foreground="#EF6C00" FontSize="15" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="30,2,0,0" FontSize="14" Foreground="#424242">
                                <Run Text="{Binding Product.Name}" FontWeight="SemiBold"/>
                                <Run Text=" — партия "/>
                                <Run Text="{Binding BatchNumber}"/>
                                <Run Text=" до "/>
                                <Run Text="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}"/>
                                <Run Text=" [" Foreground="#EF6C00"/>
                                <Run Text="{Binding Status}" Foreground="#EF6C00" FontWeight="Bold"/>
                                <Run Text="]" Foreground="#EF6C00"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="8,0,8,16">
            <TabControl Background="Transparent" BorderThickness="0" Margin="8">
                <TabItem Header="ПАРТИИ ТОВАРОВ">
                    <DataGrid ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              RowBackground="White" AlternatingRowBackground="#FAFAFA"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="*"/>
                            <DataGridTextColumn Header="Партия" Binding="{Binding BatchNumber}" Width="120"/>
                            <DataGridTextColumn Header="Остаток" Binding="{Binding Remaining}" Width="100"/>
                            <DataGridTextColumn Header="Годен до" Binding="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="ИСТОРИЯ СПИСАНИЙ">
                    <DataGrid ItemsSource="{Binding WriteOffs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Партия" Binding="{Binding Batch.BatchNumber}" Width="120"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,0,8,0">
            <Button Command="{Binding RefreshCommand}" Content="Обновить" Background="#78909C" Foreground="White" Margin="0,0,12,0" Height="40" Padding="16,0"/>
            <Button Click="BtnAdd_Click" Content="Принять партию" Background="#81C784" Foreground="White" Margin="0,0,12,0" Height="40" Padding="16,0"/>
            <Button Command="{Binding WriteOffCommand}" Content="Списать" Background="#E57373" Foreground="White" Margin="0,0,20,0" Height="40" Padding="16,0"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#757575" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>